local Theme = {
    BG =             Color3.fromRGB(12, 4, 4),
    Card =           Color3.fromRGB(20, 7, 7),
    CardHover =      Color3.fromRGB(32, 10, 10),
    Surface =        Color3.fromRGB(28, 9, 9),
    Border =         Color3.fromRGB(50, 14, 14),
    BorderHover =    Color3.fromRGB(80, 22, 22),
    Red =            Color3.fromRGB(180, 30, 30),
    RedBright =      Color3.fromRGB(210, 45, 45),
    RedDark =        Color3.fromRGB(120, 18, 18),
