    task.spawn(function() while iconF and iconF.Parent do
        Tween(iconF, {Size = UDim2.fromOffset(52, 52)}, 0.6, Enum.EasingStyle.Sine); task.wait(0.6)
        Tween(iconF, {Size = UDim2.fromOffset(48, 48)}, 0.6, Enum.EasingStyle.Sine); task.wait(0.6)
    end end)
    
    local dT = Instance.new("TextLabel"); dT.BackgroundTransparency = 1; dT.Size = UDim2.new(1, 0, 0, 0)
    dT.AutomaticSize = Enum.AutomaticSize.Y; dT.Font = Enum.Font.GothamBold; dT.Text = opts.Title or "Confirm"
    dT.TextColor3 = Theme.Text; dT.TextSize = 18; dT.TextXAlignment = Enum.TextXAlignment.Center; dT.ZIndex = 6002; dT.Parent = dC
    
    if (opts.Content or "") ~= "" then
        local ct = Instance.new("TextLabel"); ct.BackgroundTransparency = 1; ct.Size = UDim2.new(1, 0, 0, 0)
        ct.AutomaticSize = Enum.AutomaticSize.Y; ct.Font = Enum.Font.Gotham; ct.Text = opts.Content
        ct.TextColor3 = Theme.TextDim; ct.TextSize = 13; ct.TextWrapped = true
        ct.TextXAlignment = Enum.TextXAlignment.Center; ct.ZIndex = 6002; ct.Parent = dC
