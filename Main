    opts = opts or {}
    local backdrop = Instance.new("TextButton"); backdrop.Name = "AskBackdrop"
    backdrop.BackgroundColor3 = Color3.new(0,0,0); backdrop.BackgroundTransparency = 1
    backdrop.BorderSizePixel = 0; backdrop.Size = UDim2.new(1, 0, 1, 0); backdrop.Text = ""
