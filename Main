-- Spring
local Spring = {}
Spring.__index = Spring
function Spring.new(m, f, d, s)
    return setmetatable({Target=0,Position=0,Velocity=0,Mass=m or 5,Force=f or 50,Damping=d or 4,Speed=s or 4}, Spring)
end
function Spring:Update(dt)
    local dir = self.Target - self.Position
    local accel = dir * self.Force / self.Mass - self.Velocity * self.Damping
    self.Velocity = self.Velocity + accel * dt * self.Speed
    self.Position = self.Position + self.Velocity * dt * self.Speed
    return self.Position
end
function Spring:SetTarget(t) self.Target = t end
function Spring:SetPosition(p) self.Position = p end

-- Helpers
local allConns = {}

local function Tween(inst, props, dur, style, dir)
    if not inst or not inst.Parent then return nil end
    local t = TweenService:Create(inst, TweenInfo.new(dur or 0.3, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    t:Play(); return t
end
local function SpringTween(inst, props, dur)
    return Tween(inst, props, dur or 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end
local function MakeCorner(p, r) local c = Instance.new("UICorner"); c.CornerRadius = r or UDim.new(0, 8); c.Parent = p; return c end
local function MakeStroke(p, col, th, tr) local s = Instance.new("UIStroke"); s.Color = col or Theme.Border; s.Thickness = th or 1; s.Transparency = tr or 0.6; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = p; return s end
local function MakePadding(p, t, r, b, l) local pd = Instance.new("UIPadding"); pd.PaddingTop = UDim.new(0, t or 0); pd.PaddingRight = UDim.new(0, r or 0); pd.PaddingBottom = UDim.new(0, b or 0); pd.PaddingLeft = UDim.new(0, l or 0); pd.Parent = p; return pd end
local function MakeList(p, dir, pad, hA, vA) local l = Instance.new("UIListLayout"); l.FillDirection = dir or Enum.FillDirection.Vertical; l.Padding = pad or UDim.new(0, 6); l.HorizontalAlignment = hA or Enum.HorizontalAlignment.Center; l.VerticalAlignment = vA or Enum.VerticalAlignment.Top; l.SortOrder = Enum.SortOrder.LayoutOrder; l.Parent = p; return l end

local function Ripple(parent, x, y, color)
    if not parent or not parent.Parent then return end
    color = color or Theme.Red
    local r = Instance.new("Frame"); r.BackgroundColor3 = color; r.BackgroundTransparency = 0.8; r.BorderSizePixel = 0
    r.AnchorPoint = Vector2.new(0.5, 0.5); r.Position = UDim2.new(0, x, 0, y)
    r.Size = UDim2.fromOffset(0, 0); r.ZIndex = 999; r.Parent = parent; MakeCorner(r, UDim.new(1, 0))
    local m = math.max(parent.AbsoluteSize.X, parent.AbsoluteSize.Y) * 2.5
    local tw = Tween(r, {Size = UDim2.fromOffset(m, m), BackgroundTransparency = 1}, 0.55)
    if tw then tw.Completed:Connect(function() r:Destroy() end) end
end

local function Shake(inst, intensity, dur)
    if not inst then return end; intensity = intensity or 4; dur = dur or 0.25
    local orig = inst.Position
    task.spawn(function()
        local e = 0
        while e < dur do local dt = RunService.Heartbeat:Wait(); e += dt; local p = 1-e/dur
            inst.Position = UDim2.new(orig.X.Scale, orig.X.Offset+(math.random()-0.5)*2*intensity*p, orig.Y.Scale, orig.Y.Offset+(math.random()-0.5)*2*intensity*p)
        end; inst.Position = orig
    end)
end

local function HoverSpring(inst, scaleTarget)
    scaleTarget = scaleTarget or 1.012
    local spring = Spring.new(5, 80, 6, 4); spring:SetPosition(1); spring:SetTarget(1)
    local us = Instance.new("UIScale"); us.Parent = inst
    local stroke = inst:FindFirstChildOfClass("UIStroke")
    inst.MouseEnter:Connect(function()
        spring:SetTarget(scaleTarget)
        if stroke then Tween(stroke, {Color = Theme.BorderHover, Transparency = 0.3}, 0.2) end
        Tween(inst, {BackgroundColor3 = Theme.CardHover}, 0.2)
    end)
    inst.MouseLeave:Connect(function()
        spring:SetTarget(1)
        if stroke then Tween(stroke, {Color = Theme.Border, Transparency = 0.6}, 0.2) end
        Tween(inst, {BackgroundColor3 = Theme.Card}, 0.2)
    end)
    local conn = RunService.RenderStepped:Connect(function(dt)
        if not inst or not inst.Parent then return end; us.Scale = spring:Update(dt)
    end)
    table.insert(allConns, conn)
end

local function PressEffect(btn)
    local us = btn:FindFirstChildOfClass("UIScale"); if not us then return end
    btn.MouseButton1Down:Connect(function() Tween(us, {Scale = 0.96}, 0.08, Enum.EasingStyle.Quad) end)
    btn.MouseButton1Up:Connect(function() SpringTween(us, {Scale = 1}, 0.35) end)
end

local function TypeWrite(label, text, speed)
    speed = speed or 0.04; label.Text = ""; Tween(label, {TextTransparency = 0}, 0.3)
    for i = 1, #text do label.Text = string.sub(text, 1, i); task.wait(speed) end
end

