}

-- Notify
function Crimson:Notify(opts)
    opts = opts or {}
    if not self._notifHolder then
        self._notifHolder = Instance.new("Frame"); self._notifHolder.Name = "Notifs"
        self._notifHolder.BackgroundTransparency = 1; self._notifHolder.Size = UDim2.new(0, 300, 1, -20)
        self._notifHolder.Position = UDim2.new(1, -310, 0, 10); self._notifHolder.ZIndex = 5000
        self._notifHolder.Parent = self._screenGui
        MakeList(self._notifHolder, Enum.FillDirection.Vertical, UDim.new(0, 6), Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)
        MakePadding(self._notifHolder, 0, 0, 10, 0)
    end
    local typeCol = ({Info=Theme.Red, Success=Theme.Success, Warning=Theme.Warning, Error=Theme.Error})[opts.Type or "Info"] or Theme.Red
    local nf = Instance.new("CanvasGroup"); nf.BackgroundColor3 = Theme.Card; nf.BackgroundTransparency = 0.05
    nf.BorderSizePixel = 0; nf.Size = UDim2.new(1, 0, 0, 0); nf.AutomaticSize = Enum.AutomaticSize.Y
    nf.GroupTransparency = 1; nf.ZIndex = 5001; nf.Parent = self._notifHolder
    MakeCorner(nf, UDim.new(0, 10)); MakeStroke(nf, typeCol, 1, 0.5)
    local bar = Instance.new("Frame"); bar.BackgroundColor3 = typeCol; bar.BorderSizePixel = 0
    bar.Size = UDim2.new(0, 3, 1, -8); bar.Position = UDim2.new(0, 4, 0, 4); bar.ZIndex = 5002; bar.Parent = nf; MakeCorner(bar, UDim.new(1, 0))
    local cf = Instance.new("Frame"); cf.BackgroundTransparency = 1; cf.Size = UDim2.new(1, 0, 0, 0)
    cf.AutomaticSize = Enum.AutomaticSize.Y; cf.Parent = nf; MakePadding(cf, 10, 12, 10, 16); MakeList(cf, Enum.FillDirection.Vertical, UDim.new(0, 3))
    local tl = Instance.new("TextLabel"); tl.BackgroundTransparency = 1; tl.Size = UDim2.new(1, 0, 0, 0)
    tl.AutomaticSize = Enum.AutomaticSize.Y; tl.Font = Enum.Font.GothamBold; tl.Text = opts.Title or "Notification"
    tl.TextColor3 = Theme.Text; tl.TextSize = 13; tl.TextXAlignment = Enum.TextXAlignment.Left; tl.ZIndex = 5002; tl.Parent = cf
    if opts.Content and opts.Content ~= "" then
        local cl = Instance.new("TextLabel"); cl.BackgroundTransparency = 1; cl.Size = UDim2.new(1, 0, 0, 0)
        cl.AutomaticSize = Enum.AutomaticSize.Y; cl.Font = Enum.Font.Gotham; cl.Text = opts.Content
        cl.TextColor3 = Theme.TextDim; cl.TextSize = 11; cl.TextWrapped = true
        cl.TextXAlignment = Enum.TextXAlignment.Left; cl.ZIndex = 5002; cl.Parent = cf
    end
    local prog = Instance.new("Frame"); prog.BackgroundColor3 = typeCol; prog.BackgroundTransparency = 0.5
    prog.BorderSizePixel = 0; prog.Size = UDim2.new(1, 0, 0, 2); prog.Position = UDim2.new(0, 0, 1, -2)
    prog.ZIndex = 5003; prog.Parent = nf
    local dur = opts.Duration or 4
    task.spawn(function()
        task.wait(0.05); Tween(nf, {GroupTransparency = 0}, 0.4)
        Tween(prog, {Size = UDim2.new(0, 0, 0, 2)}, dur, Enum.EasingStyle.Linear)
        task.spawn(function() while bar and bar.Parent do
            Tween(bar, {BackgroundTransparency = 0.4}, 0.8, Enum.EasingStyle.Sine); task.wait(0.8)
            Tween(bar, {BackgroundTransparency = 0}, 0.8, Enum.EasingStyle.Sine); task.wait(0.8)
        end end)
        task.wait(dur); Tween(nf, {GroupTransparency = 1}, 0.35); task.wait(0.4); nf:Destroy()
    end)
end

-- Ask
