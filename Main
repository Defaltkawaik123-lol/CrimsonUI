    dC.AutomaticSize = Enum.AutomaticSize.Y; dC.Parent = dialog
    MakePadding(dC, 28, 24, 24, 24); MakeList(dC, Enum.FillDirection.Vertical, UDim.new(0, 14), Enum.HorizontalAlignment.Center)
    
    local iconF = Instance.new("Frame"); iconF.BackgroundColor3 = Theme.RedDeep; iconF.BackgroundTransparency = 0.3
    iconF.Size = UDim2.fromOffset(48, 48); iconF.ZIndex = 6002; iconF.Parent = dC
    MakeCorner(iconF, UDim.new(1, 0)); MakeStroke(iconF, Theme.Red, 1, 0.5)
    local iconL = Instance.new("TextLabel"); iconL.BackgroundTransparency = 1; iconL.Size = UDim2.new(1, 0, 1, 0)
